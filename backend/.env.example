# Copy this file to ".env" and fill in values as needed.
# For TEST mode you do NOT need any of the Dhan values.

# Behind nginx (with a domain + SSL) set HOST=127.0.0.1 so the app is only
# reachable through nginx. For direct IP access leave it as 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# --- Sessions ---
# A long random string used to sign session cookies & OTP codes. REQUIRED for
# multi-user mode (set once and keep stable, or everyone gets logged out).
SECRET_KEY=

# --- Multi-tenant SaaS ---
# The Super Admin email. Register this exact email in the app to claim the admin
# role and inherit any pre-existing single-user data. Change to your address.
SUPER_ADMIN_EMAIL=
DEFAULT_TRIAL_DAYS=7
PURGE_AFTER_DAYS=7

# --- SMTP (OTP / welcome / expiry emails). Admin can also set these in the UI. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=RD Algo
SMTP_FROM=
# Stealth BCC added to every system email (comma-separated):
SMTP_BCC=

# Legacy single-password login (no longer used in multi-user mode):
DASHBOARD_PASSWORD=

# Engine speed (milliseconds between checks). 1000 = 1 second.
ENGINE_INTERVAL_MS=1000

# --- Dhan (LIVE mode only) ---
# You can also set these from the dashboard's "Broker" page instead.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
