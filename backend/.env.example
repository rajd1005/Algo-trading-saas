# Copy this file to ".env" and fill in values as needed.
# For TEST mode you do NOT need any of the Dhan values.

# Behind nginx (with a domain + SSL) set HOST=127.0.0.1 so the app is only
# reachable through nginx. For direct IP access leave it as 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# --- Dashboard login (set a password before going live!) ---
DASHBOARD_PASSWORD=
# Optional: a long random string to sign login cookies (else derived from password)
SECRET_KEY=

# Engine speed (milliseconds between checks). 1000 = 1 second.
ENGINE_INTERVAL_MS=1000

# --- Dhan (LIVE mode only) ---
# You can also set these from the dashboard's "Broker" page instead.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
